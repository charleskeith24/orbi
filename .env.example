# ---------------------------------------------------------------------------
# AI (optional)
# Online (with Supabase), every person brings their own Claude, OpenAI or Gemini key in Settings → AI, and
# ANTHROPIC_API_KEY below is NOT used for anyone. It only powers local mode (no accounts). Without any key the
# app uses the built-in offline template engine (clearly labelled).
# ---------------------------------------------------------------------------
# Online: encrypts each person's own AI key before it's stored. Random, 32+ characters — generate it with
#   openssl rand -base64 32
# Keep it secret and don't change it casually: changing it makes every saved key unreadable (people re-add them).
AI_KEY_SECRET=
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Default: claude-opus-5
AI_MODEL=claude-opus-5
# low | medium | high | xhigh | max  (default: high)
AI_EFFORT=high

# ---------------------------------------------------------------------------
# Supabase (optional)
# Without these the app runs in local mode: data lives in this browser only.
# With them: email auth, Postgres storage with row-level security, multi-device sync.
# See docs/SUPABASE.md
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Public contact email (optional; set it before real people sign up)
# Shown as "Email us at …" on /privacy and /terms, including for account and
# access-request deletion requests from people without an account. Without it,
# those pages say no contact email is set up and point to the Feedback button.
# It is public: use a team or support inbox you're happy to publish.
# Built into the site — redeploy after changing it.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Server-side Supabase key (optional; online version only)
# Used by the admin area and the "Request access" waitlist (docs/ADMIN.md) and by
# scheduled jobs such as push reminders. Server only — never expose it to the
# browser and never commit it. Supabase → Project Settings → API Keys → Secret key.
# ---------------------------------------------------------------------------
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Push reminders (optional; online version only)
# Generate a key pair once with:  npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Required for push: a contact the push services can reach — must start with mailto: or https:
# e.g. mailto:you@example.com
VAPID_SUBJECT=
# Protects /api/cron/reminders. Any long random string; Vercel Cron sends it automatically.
CRON_SECRET=
