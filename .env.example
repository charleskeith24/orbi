# ---------------------------------------------------------------------------
# AI (optional)
# Without a key the app uses the built-in offline template engine (clearly labelled).
# ---------------------------------------------------------------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Default: claude-opus-5
AI_MODEL=claude-opus-5
# low | medium | high | xhigh | max  (default: high)
AI_EFFORT=high

# ---------------------------------------------------------------------------
# Supabase (optional)
# Without these the app runs in local mode: data lives in this browser only.
# With them: email auth, Postgres storage with row-level security, multi-device sync.
# See docs/SUPABASE.md
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Server-side Supabase key (optional; online version only)
# Used by scheduled jobs such as push reminders. Server only — never expose it
# to the browser and never commit it. Supabase → Project Settings → API Keys → Secret key.
# ---------------------------------------------------------------------------
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Push reminders (optional; online version only)
# Generate a key pair once with:  npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Required for push: a contact the push services can reach — must start with mailto: or https:
# e.g. mailto:you@example.com
VAPID_SUBJECT=
# Protects /api/cron/reminders. Any long random string; Vercel Cron sends it automatically.
CRON_SECRET=
